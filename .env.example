# Plantilla de variables de entorno.
# Cópiala como .env (en esta misma carpeta) y llena tus valores.
# El .env NO se sube al repositorio: tiene secretos y cada quien tiene el suyo.

# Clave secreta de Django. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# No la cambies después de tener datos: la bitácora la usa para firmar los eventos.
DJANGO_SECRET_KEY=

# Conexión a MySQL (la base y el usuario se crean una vez, ver BITACORA.md)
DB_NAME=festival_vallenato
DB_USER=festival
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Solo si todavía no tienes MySQL instalado: quita el # de la línea de abajo para usar SQLite.
# DB_ENGINE=sqlite
